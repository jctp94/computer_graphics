material backboard_wood
{
    receive_shadows on

    technique
    {
        pass
        {
            lighting on

            // Colores base (ajústalos a tu gusto)
            ambient  0.6 0.5 0.4 1.0
            diffuse  0.7 0.6 0.5 1.0
            specular 0.2 0.2 0.2 1.0 12.0
            emissive 0 0 0 1.0

            // Parámetros "clásicos" para que se vea bien
            depth_check on
            depth_write on
            cull_hardware clockwise
            shading gouraud

            texture_unit
            {
                texture backboard_wood.jpg
                // Opcional: mejora un poco la calidad
                filtering anisotropic
                max_anisotropy 8
                tex_address_mode clamp
            }
        }
    }
}
