material tejo_metal
{
  receive_shadows on

  technique
  {
    pass
    {
      lighting on

      // Colores base (gris metal)
      ambient  0.25 0.25 0.25 1.0
      diffuse  0.7  0.7  0.7  1.0

      // Brillo metálico fuerte (color del brillo + shininess)
      specular 1.0 1.0 1.0 1.0 64

      // El metal no emite luz por sí mismo
      emissive 0.0 0.0 0.0 1.0

      // Opcional: más parámetros “seguros”
      depth_write on
      depth_check on
      cull_hardware clockwise
      shading gouraud

      // Textura difusa del tejo (si tienes una)
      texture_unit
      {
        texture tejo.jpg
      }

      // OPCIONAL: mapa de entorno cúbico para reflejos falsos
      // (necesitas un cubemap ya creado)
      /*
      texture_unit
      {
        cubic_texture metal_env.jpg combinedUVW
        tex_coord_set 1
        env_map cubic_reflection
      }
      */
    }
  }
}


